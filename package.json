{
  "name": "@woby/three-demo",
  "version": "1.0.18",
  "publishConfig": {
    "access": "public"
  },
  "description": "Demo scripts for @woby/three",
  "//main": "./dist/Appbar.es.js",
  "//module": "./dist/Appbar.es.js",
  "//types": "./dist/types/Appbar.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "//require": "./dist/index.cjs.js",
      "import": "./dist/index.es.js",
      "types": "./dist/types/index.d.ts"
    },
    "./jsx-runtime": {
      "//require": "./dist/jsx-runtime.cjs.js",
      "import": "./dist/jsx-runtime.es.js",
      "types": "./dist/types/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "//require": "./dist/jsx-runtime.cjs.js",
      "import": "./dist/jsx-runtime.es.js",
      "types": "./dist/types/runtime.d.ts"
    }
  },
  "scripts": {
    "bump": "pnpm version patch --no-git-tag-version",
    "push": "git push && git push --tags",
    "npmjs": "pnpm publish --access public",
    "commit": "pnpm git && pnpm bump && pnpm push",
    "release": "run-s -c commit npmjs",
    "declaration": "tsc --build --force --declaration --emitDeclarationOnly --declarationMap  --verbose",
    "declaration:watch": "tsc --build --force --declaration --emitDeclarationOnly --declarationMap  --verbose --watch",
    "watch": "run-p build:watch css:watch",
    "build": "run-s build:vite && pnpm bump",
    "build:web": "vite build --config=vite.config.web.mts --mode production",
    "web": "vite preview --config=vite.config.web.mts --host",
    "dev:only": "vite --config=vite.config.web.mts --force --mode dev --host",
    "dev": "run-p dev:only",
    "build:vite": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host",
    "hosting": "firebase deploy --only hosting"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "jasmine",
    "mock",
    "woby"
  ],
  "author": "Tan Jee Han",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@rollup/plugin-alias": "^5.1.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^24.10.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.0.17",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-static-copy": "^2.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "^0.173.0",
    "@woby/three": "workspace:../three",
    "@woby/use": "workspace:../use",
    "postcss": "^8.5.6",
    "three": "^0.173.0",
    "woby": "workspace:../woby"
  }
}
